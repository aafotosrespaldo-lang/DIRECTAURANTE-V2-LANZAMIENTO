# DIRECTAURANTE CORE V2 CONFIGURATION

# MongoDB connection string (e.g. mongodb+srv://<user>:<password>@cluster0.mongodb.net/directaurante or MongoDB Atlas URI)
# Si no se proporciona en desarrollo, se utiliza el servidor embebido local automáticamente.
MONGODB_URI="mongodb://localhost:27017/directaurante_v2"

# JWT Secret key for authentication (OBLIGATORIO en producción)
JWT_SECRET="directaurante-core-v2-super-secret-key-change-in-production"
JWT_EXPIRES_IN="7d"

# CORS configuration (Origins permitidos separados por coma en producción)
CORS_ORIGIN="*"

# Seed de catálogo inicial (true para sembrar restaurantes y usuarios demo)
ENABLE_SEED="true"

# Server Port
PORT=3000
NODE_ENV="development"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, password reset links, and API endpoints.
APP_URL="MY_APP_URL"

# SERVICIO DE CORREO ELECTRÓNICO (RECUPERACIÓN DE CONTRASEÑA)
# Proveedor principal recomendado: Resend (https://resend.com)
# Si RESEND_API_KEY no está configurada, el sistema opera en modo dev con auditoría de consola segura.
RESEND_API_KEY=""
EMAIL_FROM="Directaurante <seguridad@directaurante.com>"

# ==============================================================================
# MERCADO PAGO MARKETPLACE CONFIGURATION (DIRECTAURANTE CORE V2)
# ==============================================================================
# Modo de integración: 'sandbox' para pruebas con tarjetas de prueba o 'production'
MP_MODE="sandbox"

# Credenciales de la Aplicación en Mercado Pago Developers
# Client ID de la aplicación creada en mercadopago.com/developers/panel
MP_CLIENT_ID="YOUR_MERCADO_PAGO_CLIENT_ID"
# Client Secret para el intercambio de tokens OAuth
MP_CLIENT_SECRET="YOUR_MERCADO_PAGO_CLIENT_SECRET"

# Access Token de la cuenta plataforma / Marketplace (Directaurante Master Account)
# Usado para crear las preferencias con split de comisiones (marketplace_fee)
MP_PLATFORM_ACCESS_TOKEN="TEST-YOUR_PLATFORM_ACCESS_TOKEN"

# Clave pública de la aplicación para frontend (Checkout Pro / Bricks)
MP_PUBLIC_KEY="TEST-YOUR_PUBLIC_KEY"

# Clave secreta para validación de firma HMAC (x-signature) de Webhooks
# Se obtiene en la configuración del Webhook en Mercado Pago Developers
MP_WEBHOOK_SECRET="YOUR_MERCADO_PAGO_WEBHOOK_SIGNING_SECRET"

# URL de retorno de OAuth registrada en Mercado Pago Developers (Redirect URI)
# Ej: https://tudominio.com/api/restaurant/mercadopago/callback
MP_REDIRECT_URI="http://localhost:3000/api/restaurant/mercadopago/callback"

# URL pública para recibir notificaciones Webhook de pagos
# Ej: https://tudominio.com/api/payments/mercadopago/webhook
MP_WEBHOOK_URL="http://localhost:3000/api/payments/mercadopago/webhook"

# Clave simétrica opcional para encriptar tokens en reposo (AES-256-GCM)
# Si no se define, se deriva automáticamente de forma segura a partir de JWT_SECRET
PAYMENT_ENCRYPTION_KEY=""


