# DIRECTAURANTE CORE V2 — CONFIGURACIÓN PARA VPS IONOS (UBUNTU 24.04 + MONGODB ATLAS)

# 1. MongoDB Atlas (OBLIGATORIO en producción — Prohibido fallback a memoria en VPS IONOS)
# Sustituye con tu usuario, contraseña y cluster de Atlas:
MONGODB_URI="mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/directaurante?retryWrites=true&w=majority"
MONGODB_DBName="directaurante"

# 2. JWT Secret & Sesiones (OBLIGATORIO en producción — genera una clave segura)
JWT_SECRET="directaurante-core-v2-super-secret-key-change-in-production-vps"
JWT_EXPIRES_IN="7d"

# 3. CORS & Subdominios para producción en VPS IONOS
# Permite comunicación segura entre los 4 paneles y el backend API
CORS_ORIGIN="https://cliente.directaurante.com,https://repartidores.directaurante.com,https://restaurantes.directaurante.com,https://master.directaurante.com,https://api.directaurante.com,https://directaurante.com"

# 4. URL Base del backend API en producción
APP_URL="https://api.directaurante.com"
VITE_API_URL="https://api.directaurante.com"

# 5. Entorno y Puerto del Servidor Node.js
PORT=3000
NODE_ENV="production"
ALLOW_MEMORY_FALLBACK="false"

# 6. Seed de datos inicial (establecer en "false" en producción una vez sembrado el primer usuario)
ENABLE_SEED="false"

# 7. SERVICIO DE CORREO ELECTRÓNICO (RECUPERACIÓN DE CONTRASEÑA)
# Proveedor recomendado: Resend (https://resend.com)
RESEND_API_KEY=""
EMAIL_FROM="Directaurante <seguridad@directaurante.com>"

# ==============================================================================
# MERCADO PAGO MARKETPLACE CONFIGURATION (DIRECTAURANTE CORE V2)
# ==============================================================================
# Modo de integración: 'sandbox' para pruebas seguras sin cobros reales.
# En producción solo cambiar a 'production' tras configurar credenciales de cobro reales (APP_USR-).
MP_MODE="sandbox"

# Credenciales de la Aplicación en Mercado Pago Developers (mercadopago.com/developers/panel)
MP_CLIENT_ID="YOUR_MERCADO_PAGO_CLIENT_ID"
MP_CLIENT_SECRET="YOUR_MERCADO_PAGO_CLIENT_SECRET"

# Access Token de la cuenta plataforma / Marketplace (Directaurante Master Account)
# Usado para crear las preferencias con split de comisiones (marketplace_fee)
MP_PLATFORM_ACCESS_TOKEN="TEST-YOUR_PLATFORM_ACCESS_TOKEN"

# Clave pública de la aplicación para frontend (Checkout Pro / Bricks)
MP_PUBLIC_KEY="TEST-YOUR_PUBLIC_KEY"

# Clave secreta para validación de firma HMAC (x-signature) de Webhooks
MP_WEBHOOK_SECRET="YOUR_MERCADO_PAGO_WEBHOOK_SIGNING_SECRET"

# URL de retorno de OAuth registrada en Mercado Pago Developers (Redirect URI)
MP_REDIRECT_URI="https://api.directaurante.com/api/restaurant/mercadopago/callback"

# URL pública para recibir notificaciones Webhook de pagos
MP_WEBHOOK_URL="https://api.directaurante.com/api/payments/mercadopago/webhook"

# Clave simétrica opcional para encriptar tokens en reposo (AES-256-GCM)
# Si no se define, se deriva automáticamente de forma segura a partir de JWT_SECRET
PAYMENT_ENCRYPTION_KEY=""


